# Include all source files
recursive-include src *.py
recursive-include src *.sh
recursive-include src *.in*
recursive-include src *.yaml
recursive-include src INPUT
recursive-include commands *.py

# Include configuration and documentation files
include slurm_config.yaml
include requirements.txt
include LICENSE
include README.md
include GEWUM_Manual.md

# Exclude cache and build files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .git*
